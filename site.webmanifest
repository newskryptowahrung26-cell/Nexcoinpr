{
  "name": "NexcoinPR — Crypto & Forex PR Agency",
  "short_name": "NexcoinPR",
  "description": "Official NexcoinPR app — crypto PR, forex PR, Web3 press releases, financial news, and institutional media relations.",
  "lang": "en-US",
  "dir": "ltr",
  "scope": "/",
  "start_url": "/?source=pwa",
  "id": "/?source=pwa",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "theme_color": "#0A1628",
  "background_color": "#0A1628",
  "categories": ["finance", "news", "business"],
  "icons": [
    {
